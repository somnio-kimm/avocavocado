  "entries": [
    {"id":"en-lex-11f18a2d5c866f3cb7a9","meaning":"영국을 비롯한 여러 나라에서 사용하는 언어인 영어.","exampleTranslation":"저는 영어를 배우고 있어요."},
    {"id":"en-lex-92026d226364e240979f","meaning":"말하는 사람이 주어로 자신을 가리킬 때 쓰는 말.","exampleTranslation":"저는 역 근처에 살아요."},
    {"id":"en-lex-6727e5f60d8b9c67155d","meaning":"한 곳에서 다른 곳으로 가다.","exampleTranslation":"저는 버스로 학교에 가요."},
    {"id":"en-lex-3e17f1146d3a5b394e52","meaning":"무엇을 가지고 있다.","exampleTranslation":"우리는 표 두 장을 가지고 있어요."},
    {"id":"en-lex-ebd4dd704497e7fa5168","meaning":"필요로 하다.","exampleTranslation":"물 한 잔이 필요해요."},
    {"id":"en-lex-a76f15bc9c7c655b41b7","meaning":"어떤 것이 마음에 들거나 즐겁다고 느끼다.","exampleTranslation":"저는 집에서 책 읽는 것을 좋아해요."},
    {"id":"en-lex-8be47173fb9780cedaa5","meaning":"좋거나 유용하거나 수준이 높은.","exampleTranslation":"여기는 공부하기 좋은 곳이에요."},
    {"id":"en-lex-cd6e70b18a92495e92d9","meaning":"크기나 양이 크지 않은.","exampleTranslation":"방은 작지만 편안해요."},
    {"id":"en-lex-230fb6d8a149667ce2ea","meaning":"바로 지금.","exampleTranslation":"지금 가게가 열려 있어요."},
    {"id":"en-lex-cac4638802eee2c4ceb0","meaning":"고마움을 표현하는 말.","exampleTranslation":"도와주셔서 감사합니다."},
    {"id":"en-lex-d10b0644123f631897d6","meaning":"계획을 세우거나 세부 사항을 정하다.","exampleTranslation":"도서관 밖에서 만나기로 약속했어요."},
    {"id":"en-lex-edae6fc7faf0827440de","meaning":"공통점과 차이점을 알아보려고 비교하다.","exampleTranslation":"표를 사기 전에 가격을 비교하세요."},
    {"id":"en-lex-a5255d0ee5bd4dea4876","meaning":"더 좋아지거나 더 좋게 만들다.","exampleTranslation":"꾸준한 연습은 자신감을 높일 수 있어요."},
    {"id":"en-lex-7c8298cd06aa0ead84f9","meaning":"나중에 돌려주기로 하고 빌려 쓰다.","exampleTranslation":"내일까지 우산을 빌려도 될까요?"},
    {"id":"en-lex-2aae4dbf2035adcaff9c","meaning":"사용하거나 이용하기 편리한.","exampleTranslation":"새 버스 노선은 학생들이 이용하기 편리해요."},
    {"id":"en-lex-9fed8f4df3580cfe3118","meaning":"완전히 같지는 않지만 닮은 점이 있는.","exampleTranslation":"두 강좌는 비슷한 주제를 다뤄요."},
    {"id":"en-lex-0aae75268968bf585bac","meaning":"대부분의 경우에.","exampleTranslation":"저는 보통 걸어서 출근해요."},
    {"id":"en-lex-2091be4f39c9336a1ae0","meaning":"다른 것이나 행동을 대신하여.","exampleTranslation":"기차가 취소되어 대신 버스를 탔어요."},
    {"id":"en-lex-881dca1dde99b02828b1","meaning":"자리나 방 등을 미리 확보하는 예약.","exampleTranslation":"예약을 변경하고 싶어요."},
    {"id":"en-lex-1a04afb009695c156001","meaning":"어떤 일이나 시간보다 앞서 미리.","exampleTranslation":"미리 알려 주세요."},
    {"id":"en-lex-e2fe951a014536f3935d","meaning":"무엇인지 알아보거나 확인하다.","exampleTranslation":"설문 조사는 핵심 문제를 파악하는 데 도움이 됐어요."},
    {"id":"en-lex-48d3bc54075f0deea5ac","meaning":"결과에 기여하거나 공동의 일에 보태다.","exampleTranslation":"대중교통은 공기를 더 깨끗하게 하는 데 기여할 수 있어요."},
    {"id":"en-lex-dc24572664a3cd492027","meaning":"어떤 상태를 유지하거나 계속하다.","exampleTranslation":"학교는 높은 수준을 유지하려고 해요."},
    {"id":"en-lex-823bb5c92d091e6b3bfd","meaning":"생각을 제안하거나 가능성을 시사하다.","exampleTranslation":"결과는 추가 연구가 필요함을 시사해요."},
    {"id":"en-lex-a82cb54cf4a762e85113","meaning":"검토하는 주제와 직접 관련된.","exampleTranslation":"질문과 관련된 정보만 포함하세요."},
    {"id":"en-lex-455ec704e8ac924ab319","meaning":"영향을 줄 만큼 중요하거나 큰.","exampleTranslation":"이동 습관에 큰 변화가 있었어요."},
    {"id":"en-lex-0cb744cd8585bd9c9bd7","meaning":"조금씩 서서히.","exampleTranslation":"이용자 수가 점차 증가했어요."},
    {"id":"en-lex-42276e83a7f4a1df3ea2","meaning":"앞의 내용과 대조되는 점을 제시하는 말.","exampleTranslation":"계획은 매력적이지만 비용이 많이 들 수 있어요."},
    {"id":"en-lex-1f225af580b3f5bfb94e","meaning":"결론을 뒷받침하는 사실이나 정보.","exampleTranslation":"그 주장을 뒷받침할 증거가 충분하지 않아요."},
    {"id":"en-lex-e5363a26054871381a3f","meaning":"두 가지의 차이를 강조할 때 쓰는 말.","exampleTranslation":"도시 임대료는 오른 반면 농촌 임대료는 안정적으로 유지됐어요."},
    {"id":"en-lex-0699a78369f40d3acf10","meaning":"가치나 중요성 등을 평가하다.","exampleTranslation":"정책의 장기적인 영향을 평가해야 해요."},
    {"id":"en-lex-daba376f1491114cfbdd","meaning":"결정이나 주장을 뒷받침할 충분한 이유를 제시하다.","exampleTranslation":"그 보고서만으로는 그렇게 큰 투자를 정당화할 수 없어요."},
    {"id":"en-lex-2ccf480297e84c87c3ac","meaning":"무엇을 점차 약화시키다.","exampleTranslation":"일관성 없는 결정은 대중의 신뢰를 약화시킬 수 있어요."},
    {"id":"en-lex-4bb4592ef4d3c30ba745","meaning":"어떤 사실이나 존재를 인정하다.","exampleTranslation":"저자는 연구의 한계를 인정해요."},
    {"id":"en-lex-b76f6f9aba1cd35712b9","meaning":"명확하고 논리적으로 일관된.","exampleTranslation":"일관된 주장은 이해하기 더 쉬워요."},
    {"id":"en-lex-71327d3144eceb2d74fb","meaning":"주어진 자원으로 실현할 수 있는.","exampleTranslation":"공정하면서도 실현 가능한 해결책이 필요해요."},
    {"id":"en-lex-97fcf70feee1f9813369","meaning":"앞서 말한 내용에도 불구하고.","exampleTranslation":"증거는 제한적이지만 그럼에도 연구 결과는 유용해요."},
    {"id":"en-lex-3790885c64a39843f6a3","meaning":"주로; 대부분.","exampleTranslation":"그 지역은 주로 주거 지역이에요."},
    {"id":"en-lex-6544dcfd94d0d298321c","meaning":"한 이익을 얻기 위해 다른 이익을 포기해야 하는 관계.","exampleTranslation":"속도와 정확성 사이에는 상충 관계가 있어요."},
    {"id":"en-lex-51879c30de4b5cd083ed","meaning":"여러 장단점을 고려한 결과.","exampleTranslation":"종합적으로 보면 이익이 비용보다 커요."},
    {"id":"en-lex-c73d8a2b0340b5b53e63","meaning":"조건이나 예외를 덧붙여 주장의 범위를 제한하다.","exampleTranslation":"그녀는 장기 자료가 부족함을 인정하며 주장에 단서를 달았어요."},
    {"id":"en-lex-02bcf199c9fd15faf3c3","meaning":"충분한 증거로 주장을 뒷받침하다.","exampleTranslation":"그 수치만으로는 결론을 충분히 뒷받침하지 못해요."},
    {"id":"en-lex-ff7e98d2528212ec70da","meaning":"해롭거나 불쾌한 것의 정도를 완화하다.","exampleTranslation":"더 나은 계획으로 일부 위험을 완화할 수 있어요."},
    {"id":"en-lex-775c94314e211269f7b2","meaning":"서로 충돌하는 생각이나 요구 등을 조화시키다.","exampleTranslation":"그 제안은 경제적 목표와 환경적 목표를 조화시키려 해요."},
    {"id":"en-lex-1a1980218230d10c6e3f","meaning":"미묘한 차이를 세심하게 반영하는.","exampleTranslation":"그 문제는 미묘한 차이를 반영한 더 섬세한 설명이 필요해요."},
    {"id":"en-lex-57f9f16159167d9987fe","meaning":"특정 조건이나 상황에 달려 있는.","exampleTranslation":"그 합의는 추가 협의가 이루어지는 것을 조건으로 해요."},
    {"id":"en-lex-76975c7af678edf1f97b","meaning":"실제와 다를 수 있지만 겉으로 보기에.","exampleTranslation":"그 규칙은 겉으로는 간단하지만 적용은 복잡해요."},
    {"id":"en-lex-2bde1235556f92883103","meaning":"합리적으로 주장할 수 있는 견해임을 나타내는 말.","exampleTranslation":"이것이 가장 실용적인 선택이라고 볼 수 있어요."},
    {"id":"en-lex-83b7ee0cf499dbac85ac","meaning":"특정 조건이 적용되는 범위에서.","exampleTranslation":"두 집단이 비슷한 범위에서 그 비교는 유용해요."},
    {"id":"en-lex-afc67adeb34031018239","meaning":"어떤 조건이나 규정의 적용을 받다.","exampleTranslation":"최종 일정은 승인을 받아야 확정돼요."}
  ]
}
