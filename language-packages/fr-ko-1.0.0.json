  "entries": [
    {"id":"fr-lex-c1fea87ab7ee05ed3c24","meaning":"프랑스어","exampleTranslation":"매일 프랑스어를 배워요."},
    {"id":"fr-lex-44c16cc69ff43f582bc4","meaning":"주어로 쓰는 일인칭 대명사인 나","exampleTranslation":"저는 역 근처에서 일해요."},
    {"id":"fr-lex-bfec44a36156689b88cd","meaning":"~이다; 어떤 상태에 있다","exampleTranslation":"시간에 맞춰 도착하고 싶어요."},
    {"id":"fr-lex-c068bffa97d48f4333e8","meaning":"가지고 있다","exampleTranslation":"물 한 잔 받을 수 있을까요?"},
    {"id":"fr-lex-0bacb050c23579f176a7","meaning":"가다","exampleTranslation":"시장에 갈 거예요."},
    {"id":"fr-lex-7a78cbdd46eb4edcf3af","meaning":"먹다","exampleTranslation":"사과 먹는 것을 좋아해요."},
    {"id":"fr-lex-3b686a6eb5058d7e595a","meaning":"크기가 작은","exampleTranslation":"제가 사는 집은 작아요."},
    {"id":"fr-lex-48f2ba0b0a0d83cea7e4","meaning":"좋은","exampleTranslation":"이 책은 처음 시작하기에 좋아요."},
    {"id":"fr-lex-e506a712bea3effb5626","meaning":"항상","exampleTranslation":"아침에는 항상 버스를 타요."},
    {"id":"fr-lex-970520a58a44f246f0f6","meaning":"고마움을 나타내는 말","exampleTranslation":"도와주셔서 감사합니다."},
    {"id":"fr-lex-3562ee29c74d0c1eb04f","meaning":"선택하다","exampleTranslation":"다른 날짜를 선택할 수 있어요."},
    {"id":"fr-lex-f51c9ca344d941f0cce1","meaning":"예약하다","exampleTranslation":"두 명이 앉을 자리를 예약하고 싶어요."},
    {"id":"fr-lex-dbd7bff6b0b753e1dbb7","meaning":"비교하다","exampleTranslation":"사기 전에 가격을 비교해야 해요."},
    {"id":"fr-lex-80e04eb8ca6c2666eb33","meaning":"배우다","exampleTranslation":"요리를 배우고 싶어요."},
    {"id":"fr-lex-1adf09c31476e8695839","meaning":"필요한","exampleTranslation":"예약이 필요해요."},
    {"id":"fr-lex-e5b64430bbdd6998f398","meaning":"실용적이거나 편리한","exampleTranslation":"이 가방은 여행할 때 편리해요."},
    {"id":"fr-lex-84c66034a8f279e7c96c","meaning":"이미; 벌써","exampleTranslation":"표를 이미 샀어요."},
    {"id":"fr-lex-a364b0543d880d204751","meaning":"아마; 어쩌면","exampleTranslation":"어쩌면 내일 떠날 거예요."},
    {"id":"fr-lex-1f224ee4e598e71180d8","meaning":"이유를 나타내는 말인 ~이기 때문에","exampleTranslation":"비가 와서 집에 있어요."},
    {"id":"fr-lex-30f7b3c1076874989f72","meaning":"감자","exampleTranslation":"수프에 감자 한 개를 넣어요."},
    {"id":"fr-lex-3e5e3f197019ca8a15b7","meaning":"해결하다","exampleTranslation":"함께 이 문제를 해결할 수 있어요."},
    {"id":"fr-lex-401b6ce13476d3f0ca94","meaning":"참여하다","exampleTranslation":"그 프로젝트에 참여하고 싶어요."},
    {"id":"fr-lex-86fe540fe57049a52100","meaning":"개선하다","exampleTranslation":"꾸준히 연습하면 발음이 좋아져요."},
    {"id":"fr-lex-bd81fe76c2a9da013421","meaning":"설명하다","exampleTranslation":"선택한 이유를 설명해 주실 수 있나요?"},
    {"id":"fr-lex-0bd2dc993d958aa25626","meaning":"믿을 수 있는","exampleTranslation":"믿을 수 있는 정보가 필요해요."},
    {"id":"fr-lex-4c944ecf18055371cbee","meaning":"도움이 되는","exampleTranslation":"이 경험은 매우 유익했어요."},
    {"id":"fr-lex-5130cbeade24936d979a","meaning":"그런데도; 하지만","exampleTranslation":"그는 피곤했지만 일을 마쳤어요."},
    {"id":"fr-lex-63da231443ec3d9db12a","meaning":"점차","exampleTranslation":"상황이 점차 나아지고 있어요."},
    {"id":"fr-lex-e68b86ff4797370ae5cb","meaning":"대조나 동시성을 나타내는 말","exampleTranslation":"중심가는 활기차지만 이 동네는 조용해요."},
    {"id":"fr-lex-39ca548eac5e53d8b3ef","meaning":"유리하거나 좋은 점","exampleTranslation":"집 근처에서 일하면 큰 장점이 있어요."},
    {"id":"fr-lex-f69c50c5a1c2845e8729","meaning":"평가하다","exampleTranslation":"이 결정의 결과를 평가해야 해요."},
    {"id":"fr-lex-85a7049965aa35090f11","meaning":"강조하다; 밑줄을 긋다","exampleTranslation":"보고서는 예방의 중요성을 강조해요."},
    {"id":"fr-lex-5da5595ef752392820c6","meaning":"촉진하다; 유리하게 하다","exampleTranslation":"이 조치는 협력을 촉진할 수 있어요."},
    {"id":"fr-lex-f9e117bdbb1b0c4cbfda","meaning":"타당성에 의문을 제기하다","exampleTranslation":"이 결과로 인해 우리의 가설을 다시 검토하게 됐어요."},
    {"id":"fr-lex-d3afada0807536531229","meaning":"주제에 맞거나 적절한","exampleTranslation":"적절한 지적이에요."},
    {"id":"fr-lex-4dcc51e8e72521e3f486","meaning":"논리적으로 일관된","exampleTranslation":"그녀는 일관된 주장을 제시했어요."},
    {"id":"fr-lex-2df99a4616fe39dfd375","meaning":"그럼에도 불구하고","exampleTranslation":"그 방법은 단순하지만 그럼에도 효과적이에요."},
    {"id":"fr-lex-1119fc219a68c003e3f6","meaning":"반면에","exampleTranslation":"이동 시간은 길지만 풍경은 아름다워요."},
    {"id":"fr-lex-7fb349748819d189f147","meaning":"어떤 일에 걸린 중요한 문제나 가치","exampleTranslation":"환경 보호는 중요한 과제예요."},
    {"id":"fr-lex-ebfbf90d6964c9570b1c","meaning":"더 많이","exampleTranslation":"주민들의 의견을 더 많이 들어야 해요."},
    {"id":"fr-lex-cb0124e926ab8d6e2200","meaning":"차이나 조건을 반영하여 뜻을 더 정교하게 하다","exampleTranslation":"그 말에 단서를 덧붙이고 싶어요."},
    {"id":"fr-lex-75d5358210aac049a3d3","meaning":"증거로 뒷받침하다","exampleTranslation":"정확한 자료가 그녀의 주장을 뒷받침해요."},
    {"id":"fr-lex-7fd6b6d291c2663d98f9","meaning":"서로 다른 요구나 입장을 조화시키다","exampleTranslation":"이 두 목표를 조화시키기는 어려워요."},
    {"id":"fr-lex-7c4742f8bc51f52d2ed3","meaning":"어떤 방안을 권고하거나 지지하다","exampleTranslation":"위원회는 더 점진적인 접근을 권고해요."},
    {"id":"fr-lex-a0b89afbaad141ef81d2","meaning":"그럴듯하고 타당해 보이는","exampleTranslation":"이 설명은 그럴듯해 보여요."},
    {"id":"fr-lex-71098505d31a9905fff6","meaning":"규모나 중요성이 상당한","exampleTranslation":"그 프로젝트에는 상당한 투자가 필요해요."},
    {"id":"fr-lex-15aa4afe96ea55163f74","meaning":"어떤 점을 인정하면서 말할 때 쓰는 말","exampleTranslation":"비용이 높은 것은 사실이지만 이익은 오래 지속돼요."},
    {"id":"fr-lex-d3c1289bea4255aaab71","meaning":"~하는 범위에서","exampleTranslation":"상황이 비슷한 범위에서 그 비교는 유용해요."},
    {"id":"fr-lex-642189a22bcf9258137d","meaning":"영향이나 적용이 미치는 범위","exampleTranslation":"이 결정의 영향은 지역의 범위를 넘어가요."},
    {"id":"fr-lex-67cb4ea47417d02a9c89","meaning":"직접 말하지 않고 뜻을 담아서","exampleTranslation":"그 글은 이 어려움을 암묵적으로 인정해요."},
    {"id":"fr-lex-4e1587dd3a63b118370c","meaning":"범위를 정하거나 확산을 막다","exampleTranslation":"해결책을 제안하기 전에 문제의 범위를 정해야 해요."},
    {"id":"fr-lex-3ac3331ee917dbb85815","meaning":"별도의 증거나 정보로 뒷받침하다","exampleTranslation":"두 번째 증언이 이 사건 설명을 뒷받침해요."},
    {"id":"fr-lex-ce836673a83f7cb150f7","meaning":"질문이나 문제를 피하다","exampleTranslation":"대변인은 질문을 피하려고 했어요."},
    {"id":"fr-lex-660273fda89be74049dc","meaning":"겉으로 드러난 것의 바탕이 되다","exampleTranslation":"공통된 가치가 이 합의의 바탕을 이루고 있어요."},
    {"id":"fr-lex-c923330b0cd7ba358c87","meaning":"본질적으로 그 자체에 속하는","exampleTranslation":"본질적인 가치와 시장 가치를 구별해야 해요."},
    {"id":"fr-lex-a3773f87295e526f32ee","meaning":"둘 이상의 뜻으로 해석될 수 있는","exampleTranslation":"그의 답변은 여전히 모호해요."},
    {"id":"fr-lex-b6c282ba77129c470a1e","meaning":"부차적이거나 예비적인 방안으로","exampleTranslation":"보고서는 다른 해결책도 예비적인 방안으로 검토해요."},
    {"id":"fr-lex-20562e9c9767125efdb1","meaning":"그렇더라도 여전히 ~해야 한다","exampleTranslation":"그 방법은 유망하지만 실제로 적용할 수 있어야 해요."},
    {"id":"fr-lex-b4a5b5dd4b7026e52664","meaning":"주의하지 않으면 부딪칠 수 있는 함정이나 장애물","exampleTranslation":"가장 큰 함정은 너무 성급하게 일반화하는 것이에요."},
    {"id":"fr-lex-faec0c8182ba84bdfaa1","meaning":"더욱더 그러한 이유로","exampleTranslation":"이 규칙은 성인에게 적용되며 어린이에게는 더욱 그렇습니다."}
  ]
}
