  "entries": [
    {"id":"ja-lex-148630e2c1af4f654fea","meaning":"일본","exampleTranslation":"일본에서 일본어를 공부하고 있어요."},
    {"id":"ja-lex-a4a929b90775da8b8686","meaning":"나; 저","exampleTranslation":"저는 학생이에요."},
    {"id":"ja-lex-7dc37c0b702e36c858b1","meaning":"음식을 입으로 먹다","exampleTranslation":"매일 아침 빵을 먹어요."},
    {"id":"ja-lex-df42c4ace0b1d86cb3f8","meaning":"마시다","exampleTranslation":"물을 마셔 주세요."},
    {"id":"ja-lex-e6dc63b5488f74fa46ac","meaning":"가다","exampleTranslation":"내일 학교에 가요."},
    {"id":"ja-lex-727269095b2ea15a73dc","meaning":"글을 읽다","exampleTranslation":"자기 전에 책을 읽어요."},
    {"id":"ja-lex-5dea7c8c40b107e526eb","meaning":"크기가 크다","exampleTranslation":"이 가방은 커요."},
    {"id":"ja-lex-57477273f1ccd41ed379","meaning":"크기가 작다","exampleTranslation":"작은 개가 있어요."},
    {"id":"ja-lex-e3b47489a165086effce","meaning":"항상; 늘","exampleTranslation":"항상 일곱 시에 일어나요."},
    {"id":"ja-lex-35badb8661d7c59117bf","meaning":"고마움을 나타내는 인사","exampleTranslation":"도와줘서 고마워요."},
    {"id":"ja-lex-8b955ef9f706f73eaa17","meaning":"조사하다; 찾아보다","exampleTranslation":"모르는 단어를 사전에서 찾아봐요."},
    {"id":"ja-lex-94e00b5995a4e8e6bf8b","meaning":"어떤 일을 계속하다","exampleTranslation":"매일 조금씩 공부를 계속하고 있어요."},
    {"id":"ja-lex-a82d4c5fbd0c8157f265","meaning":"시간에 맞추다","exampleTranslation":"서두르면 기차 시간에 맞출 수 있어요."},
    {"id":"ja-lex-532d768f620de956d8b2","meaning":"일을 돕다","exampleTranslation":"주말에는 아버지의 일을 도와요."},
    {"id":"ja-lex-a55475a8b7a3c2c61af9","meaning":"필요한","exampleTranslation":"예약이 필요해요."},
    {"id":"ja-lex-75a3ea14501862f1b1b4","meaning":"아쉽거나 안타까운","exampleTranslation":"만날 수 없어서 아쉬워요."},
    {"id":"ja-lex-e2df5ae1d78e4251f86e","meaning":"단단히; 제대로","exampleTranslation":"설명을 잘 들어 주세요."},
    {"id":"ja-lex-4db5d7bf7fdff5f2fb08","meaning":"가능한 한","exampleTranslation":"가능한 한 빨리 답할게요."},
    {"id":"ja-lex-4b19c800acaabfa5e94e","meaning":"앞으로 하려고 정한 일","exampleTranslation":"주말 계획을 알려 주세요."},
    {"id":"ja-lex-21bcbc7f12e152733bcb","meaning":"둘 이상을 견주다","exampleTranslation":"두 가격을 비교해 봅시다."},
    {"id":"ja-lex-f4a4e8cb6d975ec330c6","meaning":"확인하다","exampleTranslation":"출발 전에 시간을 확인했어요."},
    {"id":"ja-lex-2366a2bb747a300d59d8","meaning":"요청이나 제안을 거절하다","exampleTranslation":"다른 일정이 있어서 초대를 거절했어요."},
    {"id":"ja-lex-882925d4d1b4f4896267","meaning":"말이나 정보를 전하다","exampleTranslation":"변경한 이유를 모두에게 전했어요."},
    {"id":"ja-lex-7945ef13c0a904080f51","meaning":"건네주는 것을 받다","exampleTranslation":"어제 소포를 받았어요."},
    {"id":"ja-lex-4f407681d479c11e7e5e","meaning":"뜻이나 태도가 분명하지 않은","exampleTranslation":"설명이 모호해서 잘 이해하지 못했어요."},
    {"id":"ja-lex-fcf61383e933f74b51a9","meaning":"차분하고 부드러운","exampleTranslation":"그는 차분한 목소리로 말했어요."},
    {"id":"ja-lex-d9e452b6b88f2d8ab137","meaning":"깜빡하거나 부주의하게","exampleTranslation":"깜빡하고 열쇠를 두고 왔어요."},
    {"id":"ja-lex-ef12e24d6dbffa5b3ed8","meaning":"조금씩 점차","exampleTranslation":"새로운 생활에 점차 익숙해졌어요."},
    {"id":"ja-lex-60e5b5f30c174c16cb3b","meaning":"다른 것에 미치는 작용","exampleTranslation":"날씨가 경기에 영향을 미쳤어요."},
    {"id":"ja-lex-2170366b1f5b98ea37dc","meaning":"그런데도 불구하고","exampleTranslation":"비가 왔는데도 많은 사람이 왔어요."},
    {"id":"ja-lex-6546c64cd262eb5c4884","meaning":"여러 면에서 자세히 살피다","exampleTranslation":"다음 주 회의에서 새 제안을 검토할 거예요."},
    {"id":"ja-lex-29e81173bc5a755cb152","meaning":"부족한 부분을 채우다","exampleTranslation":"부족한 정보를 자료로 보충했어요."},
    {"id":"ja-lex-4302e135b12d79c3a191","meaning":"목표를 이루려고 힘쓰다","exampleTranslation":"알기 쉽게 설명하려고 노력하고 있어요."},
    {"id":"ja-lex-bc945824a1ba1da87aaa","meaning":"사실이나 가치를 인정하다","exampleTranslation":"그는 자신의 잘못을 인정했어요."},
    {"id":"ja-lex-63484f8b509819d81934","meaning":"상황이나 이치에 맞는","exampleTranslation":"그 판단은 타당하다고 생각해요."},
    {"id":"ja-lex-237369fe5126f2f0360f","meaning":"실수가 없도록 조심하는","exampleTranslation":"중요한 결정이므로 신중하게 생각해 봅시다."},
    {"id":"ja-lex-2ad391a44e82d888f50c","meaning":"일이 생기기 전에 미리","exampleTranslation":"필요한 서류를 미리 준비해 주세요."},
    {"id":"ja-lex-c37dcd68b253ecc77ca8","meaning":"반드시 그렇지는 않음을 나타내는 말","exampleTranslation":"비싼 물건이 반드시 좋은 것은 아니에요."},
    {"id":"ja-lex-933466f59178a9715d46","meaning":"주장이나 판단의 바탕","exampleTranslation":"판단의 근거를 설명해 주세요."},
    {"id":"ja-lex-e078d0df09f5a7a6ba36","meaning":"어떤 변화와 함께","exampleTranslation":"인구가 증가함에 따라 교통량도 늘었어요."},
    {"id":"ja-lex-7189c7fbfc0c72ab548a","meaning":"결정이나 기존 생각을 뒤집다","exampleTranslation":"새로운 증거가 기존 판단을 뒤집었어요."},
    {"id":"ja-lex-ff919e72069cf19b77fa","meaning":"어떤 사실을 바탕으로 삼다","exampleTranslation":"조사 결과를 바탕으로 방침을 재검토할 거예요."},
    {"id":"ja-lex-8942844e69c49623b3fb","meaning":"가치나 상태를 해치다","exampleTranslation":"설명이 부족하면 신뢰를 해칠 수 있어요."},
    {"id":"ja-lex-19e2436e1c2a67da992f","meaning":"자세히 살펴 분명히 판단하다","exampleTranslation":"정보의 신뢰성을 신중히 판단할 필요가 있어요."},
    {"id":"ja-lex-d86e4069f750d8dbf89d","meaning":"빈틈없이 자세하고 정교한","exampleTranslation":"치밀한 계획이 성공으로 이어졌어요."},
    {"id":"ja-lex-975fed1da96012b7225a","meaning":"뚜렷하게 드러나는","exampleTranslation":"올해는 수요 변화가 두드러졌어요."},
    {"id":"ja-lex-4011981723b7f2d9f47a","meaning":"차이를 고려하지 않고 한꺼번에","exampleTranslation":"그 방법이 무조건 나쁘다고 할 수는 없어요."},
    {"id":"ja-lex-239aee77a71498781dbf","meaning":"더 나아가 결국","exampleTranslation":"이 개선은 더 나아가 전체의 이익으로 이어질 거예요."},
    {"id":"ja-lex-ba52934d7116dabb4126","meaning":"어떤 문제에 대한 생각이나 판단","exampleTranslation":"전문가들의 견해가 엇갈리고 있어요."},
    {"id":"ja-lex-b8e1fa3cefaf4b992317","meaning":"어쩔 수 없이 어떤 일을 하게 되다","exampleTranslation":"폭우로 계획을 변경할 수밖에 없었어요."},
    {"id":"ja-lex-89bfd68ae698ccf318a7","meaning":"어떤 일이 있을 때마다","exampleTranslation":"이 사진을 볼 때마다 여행이 생각나요."}
  ]
}
