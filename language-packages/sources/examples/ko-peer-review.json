      "sourceRow": 18,
      "headword": "못",
      "priority": 2,
      "category": "inherited-English-gloss",
      "title": "Keep inability distinct from general negation",
      "problem": "The current ko-en gloss says only that 못 negates a verb. The selected NIKL sense states that the action cannot be carried out. The new sentence and every translation correctly express inability; the inherited English gloss is the part to fix. This also prevents confusion with the separately authored 안 entry.",
      "suggestedFix": {
        "correction": {
          "meaningEn": "cannot; used before a verb when an action cannot be carried out because of ability or circumstances",
          "meanings": {
            "de": "nicht können; eine Handlung ist wegen fehlender Fähigkeit oder der Umstände nicht möglich",
            "es": "no poder; indica que una acción no puede realizarse por falta de capacidad o por las circunstancias",
            "fr": "ne pas pouvoir ; l’action est empêchée par les capacités ou les circonstances",
            "ja": "〜できない；能力や事情によって動作を行えないことを表す",
            "zh": "不能；表示因能力或客观情况而无法进行某个动作"
          },
          "reason": "Restore the inability meaning present in the Korean source definition; the authored example is already aligned."
        }
      },
      "sources": [
        "https://krdict.korean.go.kr/kor/dicSearch/SearchView?ParaWordNo=17254"
      ],
      "status": "applied; native-review-pending"
    },
