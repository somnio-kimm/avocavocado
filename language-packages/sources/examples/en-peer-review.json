    {
      "findingId": "EN-PEER-003",
      "id": "en-lex-fb168cab21aa94a28ccb",
      "sourceRow": 54,
      "headword": "most",
      "priority": 2,
      "category": "Japanese-quantity-alignment",
      "title": "Avoid strengthening most to almost all",
      "problem": "The correction explicitly says most is a majority and need not be almost all. Its Japanese gloss includes ほとんど, and the example uses 客のほとんど, which readily suggests nearly all. 大半 preserves majority without that added near-total implication.",
      "suggestedFix": {
        "example": {
          "translations": {
            "ja": "客の大半は昼食前に到着しました。"
          }
        },
        "correction": {
          "meanings": {
            "ja": "大半、過半数；全体の半分を超える部分や数"
          }
        }
      },
      "sources": [
        "https://dictionary.cambridge.org/grammar/british-grammar/most-the-most-mostly"
      ],
      "status": "applied; native-review-pending"
    },
    {
      "findingId": "EN-PEER-004",
      "id": "en-lex-816f32318b8b2b76edb9",
      "sourceRow": 7,
      "headword": "this",
      "priority": 3,
      "category": "translation-specificity",
      "title": "Make the sister age consistent explicitly",
      "problem": "Korean 언니, Japanese 姉 and Chinese 姐姐 specify an older sister, whereas the English, German, Spanish and French remain age-neutral. This is a minor unavoidable kinship choice in some languages, but making older explicit in the source produces a more tightly aligned matrix.",
      "suggestedFix": {
        "example": {
          "text": "This mug belongs to my older sister.",
          "en": "This mug belongs to my older sister.",
          "translations": {
            "de": "Diese Tasse gehört meiner älteren Schwester.",
            "es": "Esta taza es de mi hermana mayor.",
            "fr": "Cette tasse appartient à ma sœur aînée."
          },
          "focus": {
            "text": "This",
            "start": 0
          }
        }
      },
      "sources": [],
      "status": "applied; native-review-pending"
    },
