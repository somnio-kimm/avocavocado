          "meaningEn": "an unspecified or unidentified thing",
          "meaningKo": "이름을 밝히지 않았거나 정체를 모르는 것; 무언가",
          "meanings": {
            "ko": "이름을 밝히지 않았거나 정체를 모르는 것; 무언가",
            "de": "etwas; eine nicht näher bezeichnete oder unbekannte Sache",
            "es": "algo; una cosa no especificada o desconocida",
            "fr": "quelque chose ; une chose non précisée ou inconnue",
            "ja": "何か；特定されていない、または分からないもの",
            "zh": "某物；未指明或身份不明的事物"
          },
          "reason": "Define the indefinite pronoun directly instead of equating it with anything or repeating itself."
        }
      },
      "sources": [
        "https://www.collinsdictionary.com/dictionary/english/something"
      ],
      "status": "applied; native-review-pending"
