  "entries": [
    {"id":"ko-lex-4f6a7cdfd7d2c07d9944","meaning":"한반도 남쪽에 있는 나라, 대한민국","exampleTranslation":"저는 한국에서 살아요."},
    {"id":"ko-lex-e036606e6bc8d10f616e","meaning":"말하는 사람이 자신을 낮추어 가리키는 말","exampleTranslation":"저는 학생이에요."},
    {"id":"ko-lex-486fb17d6ce4b171a2dc","meaning":"한 곳에서 다른 곳으로 이동하다","exampleTranslation":"내일 학교에 가요."},
    {"id":"ko-lex-04b617cbf039902727a3","meaning":"음식을 입에 넣어 삼키다","exampleTranslation":"아침에 빵을 먹어요."},
    {"id":"ko-lex-fabf456151ed89d0ea14","meaning":"물이나 음료를 입으로 넘기다","exampleTranslation":"물을 조금 마실게요."},
    {"id":"ko-lex-f2b71b46cbddf17d632b","meaning":"글을 보고 내용을 이해하거나 소리 내어 말하다","exampleTranslation":"도서관에서 책을 읽어요."},
    {"id":"ko-lex-f392455899604900cfed","meaning":"마음에 들거나 상태가 바람직하다","exampleTranslation":"오늘은 날씨가 좋아요."},
    {"id":"ko-lex-27644f84b65b06a1e63a","meaning":"길이, 넓이 또는 부피가 보통보다 많다","exampleTranslation":"이 가방은 너무 커요."},
    {"id":"ko-lex-eb9b818583f1d8b4228d","meaning":"말하는 바로 이때","exampleTranslation":"지금 집에 있어요."},
    {"id":"ko-lex-8f567bfb3ef6556eac90","meaning":"고마움을 정중하게 표현하는 말","exampleTranslation":"도와주셔서 감사합니다."},
    {"id":"ko-lex-eb8b212580fa94f3ab0a","meaning":"앞으로 할 일의 방법과 순서를 미리 정하다","exampleTranslation":"친구들과 여행을 계획하고 있어요."},
    {"id":"ko-lex-6677065e37b616cc2746","meaning":"말이나 상황의 뜻을 알아듣다","exampleTranslation":"설명을 듣고 내용을 이해했어요."},
    {"id":"ko-lex-7f8165c3138849a44205","meaning":"어떤 일을 하기로 다른 사람과 정하다","exampleTranslation":"내일 다시 만나기로 약속했어요."},
    {"id":"ko-lex-b208f2ea6ae032682d1f","meaning":"좋지 않은 일이 생길까 마음을 쓰다","exampleTranslation":"부모님은 제 건강을 걱정하세요."},
    {"id":"ko-lex-b4266ed2a2d2743e568f","meaning":"쓰거나 이용하기에 쉽고 편하다","exampleTranslation":"이곳은 교통이 편리해요."},
    {"id":"ko-lex-2da0fe222f4b2c6b4ffc","meaning":"서로 닮은 점이 많다","exampleTranslation":"두 가방의 색이 비슷해요."},
    {"id":"ko-lex-a4d5916d20c0131e727e","meaning":"어떤 일이 생기기 전에 앞서","exampleTranslation":"표를 미리 샀어요."},
    {"id":"ko-lex-d7ac7c50e9da09f8dde2","meaning":"생각한 것보다 이른 때에","exampleTranslation":"벌써 점심시간이네요."},
    {"id":"ko-lex-9f96627881ced2f6e078","meaning":"직접 겪거나 해 본 일","exampleTranslation":"처음 해 보는 좋은 경험이었어요."},
    {"id":"ko-lex-b53b6d598593968e317f","meaning":"앞말이 뒤에 오는 일의 이유임을 나타내는 말","exampleTranslation":"비가 와요. 그래서 집에 있어요."},
    {"id":"ko-lex-fcbed961ab11f859677f","meaning":"어떤 활동이나 일에 함께하다","exampleTranslation":"많은 학생이 행사에 참여했어요."},
    {"id":"ko-lex-17625633c24b09b9de48","meaning":"둘 이상을 살펴 공통점과 차이점을 알아보다","exampleTranslation":"두 방법의 장단점을 비교했어요."},
    {"id":"ko-lex-e7f14362e3e44cd2af5c","meaning":"문제나 어려움을 처리하여 없애다","exampleTranslation":"함께 노력해서 문제를 해결했어요."},
    {"id":"ko-lex-d0bd0a984b54ba6c2e17","meaning":"여러 가지 중에서 하나를 고르다","exampleTranslation":"자신에게 맞는 방법을 선택하세요."},
    {"id":"ko-lex-6388e474c174b6129b1a","meaning":"상황이나 목적에 알맞다","exampleTranslation":"상황에 적절한 표현을 써야 해요."},
    {"id":"ko-lex-5dd8a64b18cc5115c7d3","meaning":"오랫동안 쉬지 않고 한결같다","exampleTranslation":"실력을 늘리려면 꾸준한 연습이 필요해요."},
    {"id":"ko-lex-7b38f7843f18cb63fd58","meaning":"시간이 흐르면서 조금씩","exampleTranslation":"새로운 환경에 점차 익숙해졌어요."},
    {"id":"ko-lex-75a1745d2aafa555e804","meaning":"예상이나 일반적인 생각과 반대로","exampleTranslation":"비가 그치자 오히려 더 추워졌어요."},
    {"id":"ko-lex-a74e5509616d118e9013","meaning":"다른 것의 상태나 행동을 바꾸는 작용","exampleTranslation":"생활 습관은 건강에 영향을 줘요."},
    {"id":"ko-lex-a305852f924c91f42118","meaning":"앞의 내용과 대조되는 내용을 이끄는 말","exampleTranslation":"이 방법은 빠른 반면에 비용이 많이 들어요."},
    {"id":"ko-lex-0f7423d9a316e504bd20","meaning":"내용을 여러 요소로 나누어 자세히 살피다","exampleTranslation":"설문 결과를 항목별로 분석했어요."},
    {"id":"ko-lex-94499568cb4411feb44b","meaning":"생각이나 방법을 다른 사람에게 내놓다","exampleTranslation":"그는 새로운 해결책을 제안했어요."},
    {"id":"ko-lex-7f0f71b3bac9560ea684","meaning":"자신의 의견이 옳다고 내세우다","exampleTranslation":"발표자는 제도를 바꿔야 한다고 주장했어요."},
    {"id":"ko-lex-d3085126233b1c5f58d9","meaning":"의견이나 상황을 결과에 담아 나타내다","exampleTranslation":"계획에 주민들의 의견을 반영했어요."},
    {"id":"ko-lex-6ea105ba09e4fcb22a1e","meaning":"개인의 감정에 치우치지 않고 사실에 근거한","exampleTranslation":"객관적인 자료를 바탕으로 판단해야 해요."},
    {"id":"ko-lex-1a94ac6a25e7f9a07837","meaning":"적은 시간이나 노력으로 좋은 결과를 얻는","exampleTranslation":"업무를 효율적으로 나누었어요."},
    {"id":"ko-lex-ed920337449a2b385b0c","meaning":"틀림없이 꼭","exampleTranslation":"신청서를 반드시 기한 안에 제출하세요."},
    {"id":"ko-lex-97dd81810207528b4f41","meaning":"정도가 꽤 높게","exampleTranslation":"새 장비를 쓰니 시간이 상당히 줄었어요."},
    {"id":"ko-lex-4f0e2cec4bdfe6abf8ed","meaning":"생각이나 판단을 뒷받침하는 사실","exampleTranslation":"주장을 뒷받침할 근거가 필요해요."},
    {"id":"ko-lex-6d4dc831e5684cf28e04","meaning":"앞의 상황과 관계없이 뒤의 일이 성립함을 나타내는 말","exampleTranslation":"어려움이 많았어요. 그럼에도 불구하고 끝까지 노력했어요."},
    {"id":"ko-lex-8bc85b55f33759b68ed9","meaning":"증거로 사실임을 밝히다","exampleTranslation":"연구팀은 실험으로 가설을 입증했어요."},
    {"id":"ko-lex-eba7ab1e66812660de81","meaning":"서로 조금씩 양보하여 의견을 맞추다","exampleTranslation":"양측은 조건을 조정하며 타협했어요."},
    {"id":"ko-lex-5b034d22443d74a6015d","meaning":"어떤 목표나 방향을 향해 나아가다","exampleTranslation":"이 사업은 장기적인 변화를 지향해요."},
    {"id":"ko-lex-51e044eda0331c3d0206","meaning":"중요한 것을 알아보지 못하고 지나치다","exampleTranslation":"작은 차이라고 해서 간과해서는 안 돼요."},
    {"id":"ko-lex-fec9f926c9af993ebc52","meaning":"이치에 맞고 근거가 충분하다","exampleTranslation":"그 설명은 충분히 타당해 보여요."},
    {"id":"ko-lex-a5334b101b99b23f8967","meaning":"피하거나 막을 수 없다","exampleTranslation":"안전 점검을 위해 일정 변경이 불가피해요."},
    {"id":"ko-lex-ad9658eef645a16e3f79","meaning":"처음부터 끝까지 같은 원칙으로","exampleTranslation":"그는 일관되게 같은 입장을 유지했어요."},
    {"id":"ko-lex-d5b93163ae22b52a7deb","meaning":"최종 결정 전까지 임시로","exampleTranslation":"회의 날짜를 잠정적으로 정했어요."},
    {"id":"ko-lex-b87477b9ad5dc50d0f4b","meaning":"사물을 보고 판단하는 입장","exampleTranslation":"서로 다른 관점에서 문제를 살펴봤어요."},
    {"id":"ko-lex-8d9e808987bafd7a9129","meaning":"앞의 내용에 다른 내용을 더하는 말","exampleTranslation":"이 책은 흥미로울 뿐만 아니라 내용도 정확해요."},
    {"id":"ko-lex-6269abde0c548a5510a6","meaning":"겉으로 드러내지 않은 뜻을 속에 담다","exampleTranslation":"그 표현은 여러 의미를 함축하고 있어요."},
    {"id":"ko-lex-37d710cdfd72fd054871","meaning":"의견이나 요구를 단번에 물리치다","exampleTranslation":"위원회는 근거 없는 주장을 일축했어요."},
    {"id":"ko-lex-1365c4abcf4babc54d70","meaning":"서로 다른 의견이나 조건을 맞추다","exampleTranslation":"담당자는 여러 부서의 일정을 조율했어요."},
    {"id":"ko-lex-f1c4671f45d7b5f9e512","meaning":"자료나 논의에서 결과를 이끌어 내다","exampleTranslation":"자료를 검토한 뒤 결론을 도출했어요."},
    {"id":"ko-lex-cd6ccf0550aec53b8188","meaning":"의견 차이나 대립이 매우 날카롭다","exampleTranslation":"그 사안을 둘러싼 의견 대립이 첨예해요."},
    {"id":"ko-lex-0fff2cba7af0e259b7c3","meaning":"어떤 일이 실제로 일어날 만한 가능성","exampleTranslation":"설명에 논리적인 개연성이 부족해요."},
    {"id":"ko-lex-7a22ed511d0fec995e34","meaning":"서로 맞지 않거나 충돌하다","exampleTranslation":"두 목표가 서로 상충할 수 있어요."},
    {"id":"ko-lex-fa7fe89f0fb90778030a","meaning":"단지 그것만은 아님을 나타내는 말","exampleTranslation":"이는 비단 한 지역만의 문제가 아니에요."},
    {"id":"ko-lex-f6d43276a82c71496270","meaning":"여러 과정을 거쳐 마지막에","exampleTranslation":"이 정책은 궁극적으로 삶의 질을 높이려는 것이에요."},
    {"id":"ko-lex-66e8c06ee547441e82bb","meaning":"나중에 다른 판단이나 행동을 할 가능성을 남기다","exampleTranslation":"결론을 내리되 추가 논의의 여지를 남겼어요."}
  ]
}
