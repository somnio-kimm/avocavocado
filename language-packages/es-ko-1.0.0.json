  "entries": [
    {"id":"es-lex-c0c210e06af46bd5be4b","meaning":"스페인어","exampleTranslation":"매일 스페인어를 공부해요."},
    {"id":"es-lex-d5cead51d00ec90643ef","meaning":"주어로 쓰는 일인칭 대명사인 나","exampleTranslation":"저는 역 근처에 살아요."},
    {"id":"es-lex-61b7f5642cbb677e514f","meaning":"정체성이나 특징을 나타내는 말인 ~이다","exampleTranslation":"선생님이 되고 싶어요."},
    {"id":"es-lex-54d96cf95ff7f48438bd","meaning":"가지고 있다","exampleTranslation":"공부할 시간이 더 필요해요."},
    {"id":"es-lex-3b5d9bb2e403eb514817","meaning":"가다","exampleTranslation":"시장에 갈 거예요."},
    {"id":"es-lex-36de61b24a98063140b0","meaning":"먹다","exampleTranslation":"아침에 과일 먹는 것을 좋아해요."},
    {"id":"es-lex-34d361c9508ae7f7db31","meaning":"크기가 작은","exampleTranslation":"집은 작지만 편안해요."},
    {"id":"es-lex-5cab4dad445784374f26","meaning":"좋은","exampleTranslation":"이 책은 처음 시작하기에 좋아요."},
    {"id":"es-lex-717395698deef7b879ac","meaning":"항상","exampleTranslation":"항상 일곱 시에 아침을 먹어요."},
    {"id":"es-lex-5ac89e00f4292251d0a8","meaning":"고마움을 표현하는 말","exampleTranslation":"도와줘서 고마워요."},
    {"id":"es-lex-1bd059c685b466db4ae2","meaning":"비교하다","exampleTranslation":"사기 전에 가격을 비교하고 싶어요."},
    {"id":"es-lex-3fa672c7ae8ef505467e","meaning":"예약하다","exampleTranslation":"네 명이 앉을 자리를 예약할 거예요."},
    {"id":"es-lex-ffcc64ed0f3a7fa1dfdf","meaning":"고르다","exampleTranslation":"원하는 시간을 고를 수 있어요."},
    {"id":"es-lex-3f812598bb4dcd14a062","meaning":"배우다","exampleTranslation":"다른 사람들과 함께 배우면 재미있어요."},
    {"id":"es-lex-96c74c4ef12abde2650a","meaning":"필요한","exampleTranslation":"여권을 가져가야 해요."},
    {"id":"es-lex-3f9a4377ffa17cac62c6","meaning":"비슷한","exampleTranslation":"두 건물은 매우 비슷해요."},
    {"id":"es-lex-7efcc42e0ff9e514a405","meaning":"아직","exampleTranslation":"아직 일을 마치지 못했어요."},
    {"id":"es-lex-2d21ccf42bc7a79b0b41","meaning":"아마; 어쩌면","exampleTranslation":"어쩌면 내일 나갈 수 있을 거예요."},
    {"id":"es-lex-d85106d02d07926de369","meaning":"그 때문에; 그래서","exampleTranslation":"비가 와서 우산을 가져가요."},
    {"id":"es-lex-a4575e8f0f40efd93562","meaning":"직접 겪거나 해 본 일","exampleTranslation":"매우 유익한 경험이었어요."},
    {"id":"es-lex-92efd7db02d443d7b36f","meaning":"문제나 어려움을 해결하다","exampleTranslation":"함께 문제를 해결할 수 있어요."},
    {"id":"es-lex-f1f322d0a19fb1286f26","meaning":"참여하다","exampleTranslation":"그 프로젝트에 참여하고 싶어요."},
    {"id":"es-lex-5097fb8e51ab482a0fd7","meaning":"개선하다; 나아지다","exampleTranslation":"매일 연습하면 발음이 좋아져요."},
    {"id":"es-lex-9a4d34f059e4cdaa93eb","meaning":"설명하다","exampleTranslation":"이 기계가 어떻게 작동하는지 설명해 줄 수 있나요?"},
    {"id":"es-lex-3f27bb569b3c3949ee1b","meaning":"적절한; 알맞은","exampleTranslation":"적절한 해결책을 찾아야 해요."},
    {"id":"es-lex-922ece7af4a1645e1172","meaning":"믿을 수 있는","exampleTranslation":"믿을 수 있는 정보가 필요해요."},
    {"id":"es-lex-24ddf283ca99b18da22a","meaning":"점차","exampleTranslation":"상황이 점차 나아졌어요."},
    {"id":"es-lex-990fc2f50f6db9b91509","meaning":"게다가; 또한","exampleTranslation":"강좌는 흥미롭고 게다가 무료예요."},
    {"id":"es-lex-baaff14bf1bfda7d6cf4","meaning":"~이지만; ~에도 불구하고","exampleTranslation":"그녀는 피곤했지만 일을 마쳤어요."},
    {"id":"es-lex-070aa2b80b0c8c2aab94","meaning":"유리하거나 좋은 점","exampleTranslation":"집 근처에서 일하면 장점이 많아요."},
    {"id":"es-lex-cfc68af3afbfc041f055","meaning":"평가하다","exampleTranslation":"팀은 그 결정의 결과를 평가해야 해요."},
    {"id":"es-lex-ea3f981911f42d8ebad1","meaning":"문제를 제기하거나 의견을 내놓다","exampleTranslation":"그 연구는 새로운 질문을 제기해요."},
    {"id":"es-lex-e4168369cfeaa7518c09","meaning":"입장을 유지하거나 주장하다","exampleTranslation":"저자는 제도를 바꿔야 한다고 주장해요."},
    {"id":"es-lex-b4171273119901932492","meaning":"촉진하다; 장려하다","exampleTranslation":"그 계획은 협력을 촉진하려고 해요."},
    {"id":"es-lex-3e584f1d82bb8f226422","meaning":"실현 가능한","exampleTranslation":"장기적으로 실현 가능한 대안을 찾고 있어요."},
    {"id":"es-lex-f7a94be6432b86297730","meaning":"관련성이 있거나 중요한","exampleTranslation":"관련 있는 자료만 포함하는 것이 좋아요."},
    {"id":"es-lex-9df2f53f3c09757205b0","meaning":"그러나; 그럼에도","exampleTranslation":"그 제안은 유용하지만 몇 가지 수정이 필요해요."},
    {"id":"es-lex-5f275e7887b8b4f1fdb0","meaning":"그러므로","exampleTranslation":"증거가 충분하지 않으므로 조사를 계속해야 해요."},
    {"id":"es-lex-922c6daff1a0568dd389","meaning":"판단의 기준","exampleTranslation":"명확한 기준을 정해야 해요."},
    {"id":"es-lex-22d35dfa062e15911284","meaning":"조금씩 점진적으로","exampleTranslation":"수요가 점차 증가했어요."},
    {"id":"es-lex-30d9521d9db57130e87f","meaning":"차이나 조건을 덧붙여 뜻을 더 정교하게 하다","exampleTranslation":"앞서 한 말에 단서를 덧붙이고 싶어요."},
    {"id":"es-lex-774df332b387558dd331","meaning":"뒷받침하다; 지지하다","exampleTranslation":"결과는 우리의 해석을 뒷받침해요."},
    {"id":"es-lex-c777f2af39738c1d9e84","meaning":"서로 다른 요구나 입장을 조화시키다","exampleTranslation":"그렇게 다른 이해관계를 조정하기는 어려워요."},
    {"id":"es-lex-522a5156731ccbfcdba3","meaning":"타당성에 의문을 제기하다","exampleTranslation":"여러 전문가가 그 결론에 의문을 제기했어요."},
    {"id":"es-lex-ec2e1b2a59b7e2af4011","meaning":"논리적으로 일관된","exampleTranslation":"보고서는 일관된 주장을 제시해요."},
    {"id":"es-lex-31c36cef79be5b27f19d","meaning":"피할 수 없는","exampleTranslation":"이런 상황에서는 변화가 불가피해 보여요."},
    {"id":"es-lex-de6ff88816f51a4e9e5d","meaning":"또한; 마찬가지로","exampleTranslation":"그 프로젝트는 비용을 줄이고 서비스도 개선할 거예요."},
    {"id":"es-lex-e6b736c9c52ba3a92e43","meaning":"~하는 범위에서","exampleTranslation":"사례가 비슷한 범위에서 그 비교는 유용해요."},
    {"id":"es-lex-6b8c4655270e1b76065d","meaning":"영향이나 적용이 미치는 범위","exampleTranslation":"개혁의 범위를 아직 완전히 알지는 못해요."},
    {"id":"es-lex-524bc4f05551b104c6e0","meaning":"주장이나 추정에 따르면","exampleTranslation":"원본으로 알려졌던 자료는 사본인 것으로 드러났어요."},
    {"id":"es-lex-b847832f004df3aded01","meaning":"불분명한 문제를 밝혀내다","exampleTranslation":"위원회는 갈등의 원인을 밝히려고 했어요."},
    {"id":"es-lex-11741b885f561496d168","meaning":"문제나 책임을 피하여 넘기다","exampleTranslation":"그렇게 중요한 어려움을 외면해서는 안 돼요."},
    {"id":"es-lex-a3217d12401c32cbd26d","meaning":"겉으로 드러난 것의 바탕에 놓여 있다","exampleTranslation":"그 제안의 바탕에 있는 가정들을 검토해야 해요."},
    {"id":"es-lex-8fa86b530297d12cfd07","meaning":"근거나 주장을 내세우다","exampleTranslation":"대변인은 결정을 정당화하려고 경제적인 이유를 내세웠어요."},
    {"id":"es-lex-20395158b7eb14b1dde5","meaning":"확실하게 입증할 수 있는","exampleTranslation":"무슨 일이 있었는지 확실한 증거가 필요해요."},
    {"id":"es-lex-b68f7228a0c951bf6287","meaning":"본질적으로 따로 떼어 낼 수 없는","exampleTranslation":"불확실성은 이런 연구에 본질적으로 따르는 것이에요."},
    {"id":"es-lex-4ac9f1bfe6f873550aba","meaning":"어김없이; 필연적으로","exampleTranslation":"모든 변화는 어김없이 전체에 영향을 미쳐요."},
    {"id":"es-lex-97f84925da6519386ea9","meaning":"그 때문에 ~인 것이다","exampleTranslation":"자료가 불완전하기 때문에 신중해야 해요."},
    {"id":"es-lex-dffcc9b069189e7c4c4b","meaning":"서로 일치하지 않거나 의견이 다른 점","exampleTranslation":"두 설명이 다른 이유를 밝혀야 해요."},
    {"id":"es-lex-6ea1340163301caed245","meaning":"설령 ~하더라도","exampleTranslation":"어려움이 생기더라도 약속을 지킬 거예요."}
  ]
}
